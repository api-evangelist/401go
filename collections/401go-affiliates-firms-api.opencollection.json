{
  "opencollection": "1.0.0",
  "info": {
    "name": "401GO Affiliates & Firms API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Affiliates & Firms",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "affiliate_firms_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.401go.com/api/affiliate-firms/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all affiliate firms the authenticated user has permission to access."
        },
        {
          "info": {
