            "name": "participants_portfolio_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.401go.com/api/participants/:participant_id/portfolio/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "participant_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
