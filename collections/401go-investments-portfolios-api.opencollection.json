        },
        {
          "info": {
            "name": "participants_investment_performance_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.401go.com/api/participants/:participant_id/investment-performance/",
            "params": [
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date for filtering portfolios (YYYY-MM-DD format). Defaults to today."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "participant_id",
                "value": "",
