{
  "opencollection": "1.0.0",
  "info": {
    "name": "401GO Notifications API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "participants_notifications_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.401go.com/api/participants/:participant_id/notifications/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "participant_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a list of notifications for a participant."
        },
        {
          "info": {
            "name": "participants_notifications_partial_update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.401go.com/api/participants/:participant_id/notifications/:notification_id/",
            "params": [
              {
                "name": "notification_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "participant_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        },
        {
          "info": {
            "name": "participants_notifications_attachment_retrieve",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.401go.com/api/participants/:participant_id/notifications/attachment/:attachment_id/",
            "params": [
              {
                "name": "attachment_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "participant_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a signed url for the given attachment that will last for 30 minutes."
        }
      ]
    }
  ],
  "bundled": true
}